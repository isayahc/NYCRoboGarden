# Sponsor configuration template for NYC Robo Garden.
# Copy with: cp -n example.env .env
# Fill only the integrations you enable. No live credentials belong here.
# These are project configuration names: application code must load .env and
# pass values to each SDK. This template does not implement integrations.

# VIAM — required when connecting to a Viam machine.
# Get address, API key and key ID from the machine's CONNECT tab:
# https://app.viam.com/
# Use the machine hostname shown there, without an https:// prefix.
# https://docs.viam.com/build-apps/setup/python/
VIAM_MACHINE_ADDRESS=
VIAM_API_KEY=
VIAM_API_KEY_ID=

# Optional component names, exactly as configured on that machine.
# Fill only when the corresponding component is used.
VIAM_ARM_NAME=
VIAM_CAMERA_NAME=
VIAM_GRIPPER_NAME=

# TAVILY — for authenticated search/extraction/crawling requests.
# Create a key at https://app.tavily.com/
# https://docs.tavily.com/
TAVILY_API_KEY=

# VONAGE — configure only the authentication needed by the chosen API.
# Account API key and secret: https://dashboard.vonage.com/
# https://developer.vonage.com/en/getting-started/concepts/authentication
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Optional: application ID and private key for JWT-authenticated APIs,
# such as Voice or application-based Messages/Video integrations.
# Download the private key from your Vonage application. Store it under the
# ignored secrets/ directory; set a path such as ./secrets/vonage-private.key.
# This variable contains a FILE PATH, not the PEM key contents.
# Application code must read that file and pass the key to the SDK.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=

# Optional: signed webhook/message verification, if the chosen API uses it.
# This is distinct from the account API secret.
VONAGE_SIGNATURE_SECRET=
